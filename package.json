{
  "name": "theodoitiendo-desktop",
  "version": "1.1.1",
  "description": "Ứng dụng theo dõi tiến độ công việc trên máy tính",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.theodoitiendo.desktop",
    "productName": "TheoDoiTienDo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "start_app.exe",
        "to": "start_app.exe"
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "TheoDoiTienDo"
    }
  }
}
